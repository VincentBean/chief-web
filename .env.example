# ---------------------------------------------------------------------------
# chief-web configuration
#
# Copy to `.env` and adjust:  cp .env.example .env
# Every value below has a working default except CHIEF_WEB_PASSWORD, which you
# should always set before exposing the UI.
# ---------------------------------------------------------------------------

# --- Web server ------------------------------------------------------------

# Host port the web UI is published on. The container always listens on 8080.
CHIEF_WEB_PORT=8080

# Shared password protecting the entire UI and API (US-003). There are no user
# accounts — everyone who knows this password is the operator. Leave empty only
# for local experiments on a trusted machine.
CHIEF_WEB_PASSWORD=

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# --- Build loop ------------------------------------------------------------

# Maximum number of sessions that may build at the same time. Sessions started
# beyond this cap are queued FIFO (US-018).
MAX_CONCURRENT_SESSIONS=3

# --- Data paths (inside the container) -------------------------------------
#
# These are set by docker-compose.yml and rarely need changing. They matter for
# running the server outside Docker, where they default to `./.data/...`.

# Root of the application data volume (`chief-data`).
# DATA_DIR=/data

# SQLite database file (default: $DATA_DIR/chief-web.db).
# DATABASE_PATH=/data/chief-web.db

# Generated SSH deploy keys for registered repositories (default: $DATA_DIR/ssh-keys).
# SSH_KEYS_DIR=/data/ssh-keys

# Per-session repository clones (default: $DATA_DIR/workspaces).
# WORKSPACES_DIR=/data/workspaces

# Claude Code credentials, shared by every session container via the
# `claude-auth` volume (default: $DATA_DIR/claude-auth outside Docker).
# CLAUDE_AUTH_DIR=/claude-auth

# Docker socket used to spawn one container per session.
# DOCKER_SOCKET=/var/run/docker.sock

# Directory with the built frontend assets (default: ./web/dist).
# WEB_ROOT=/app/web/dist

# Port and bind address the Node process listens on inside the container.
# PORT=8080
# HOST=0.0.0.0
