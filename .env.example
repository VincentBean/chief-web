# ---------------------------------------------------------------------------
# chief-web configuration
#
# Copy to `.env` and adjust:  cp .env.example .env
# Every value below has a working default except CHIEF_WEB_PASSWORD, which you
# should always set before exposing the UI.
# ---------------------------------------------------------------------------

# --- Web server ------------------------------------------------------------

# Host port the web UI is published on. The container always listens on 8080.
CHIEF_WEB_PORT=8080

# Shared password protecting the entire UI and API (US-003). There are no user
# accounts — everyone who knows this password is the operator. When set, it
# always wins over any previously generated password. If left empty, the server
# generates one on first boot, logs it once (`docker compose logs server`) and
# stores only its hash — so set this if you want a password you chose yourself.
CHIEF_WEB_PASSWORD=

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# --- Build loop ------------------------------------------------------------

# Default maximum number of sessions that may build at the same time. Sessions
# started beyond this cap are queued FIFO (US-018). This is only the default:
# once the value is saved on the Settings page it is read from the database.
MAX_CONCURRENT_SESSIONS=3

# --- Repositories ----------------------------------------------------------

# Image used for session containers and for the short-lived container that runs
# the "Test connection" check on a repository (`git ls-remote`). Built from
# `runner/Dockerfile` by `docker compose build`; only change this if you build
# and tag the runner image yourself.
# RUNNER_IMAGE=chief-web-runner:latest

# How long a repository connection test may take before it is killed.
# CONNECTION_TEST_TIMEOUT_MS=60000

# Docker CLI used to start those short-lived containers.
# DOCKER_BIN=docker

# --- Session containers ----------------------------------------------------

# The git identity agents commit with inside session containers is NOT set here
# — it is configured on the Settings page and defaults to
# `chief-web <chief-web@localhost>`, which is also baked into the runner image.

# --- GitHub ----------------------------------------------------------------

# The GitHub Personal Access Token used to open pull requests is NOT set here —
# it is entered on the Settings page and stored in the database, so it can be
# rotated without a restart.

# Base URL of the GitHub REST API. Only change this for GitHub Enterprise.
# GITHUB_API_URL=https://api.github.com

# --- Data paths (inside the container) -------------------------------------
#
# These are set by docker-compose.yml and rarely need changing. They matter for
# running the server outside Docker, where they default to `./.data/...`.

# Root of the application data volume (`chief-data`).
# DATA_DIR=/data

# SQLite database file (default: $DATA_DIR/chief-web.db).
# DATABASE_PATH=/data/chief-web.db

# SSH deploy keys for registered repositories, one 0600 file per repository
# (default: $DATA_DIR/ssh-keys).
# SSH_KEYS_DIR=/data/ssh-keys

# Per-session repository clones (default: $DATA_DIR/workspaces).
# WORKSPACES_DIR=/data/workspaces

# Claude Code credentials, shared by every session container via the
# `claude-auth` volume (default: $DATA_DIR/claude-auth outside Docker).
# CLAUDE_AUTH_DIR=/claude-auth

# Docker socket used to spawn one container per session.
# DOCKER_SOCKET=/var/run/docker.sock

# Directory with the built frontend assets (default: ./web/dist).
# WEB_ROOT=/app/web/dist

# Port and bind address the Node process listens on inside the container.
# PORT=8080
# HOST=0.0.0.0
